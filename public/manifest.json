{
  "manifest_version": 3,
  "name": "Rueckblick",
  "version": "0.3.0",
  "description": "Thin sensor/actuator for the Rueckblick screen-time budget: samples the focused tab and hard-blocks exhausted URLs via the desktop-app bridge.",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["tabs", "storage", "alarms", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rueckblick"
  },
  "web_accessible_resources": [
    {
      "resources": ["block.html"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
