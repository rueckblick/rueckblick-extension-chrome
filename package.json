{
  "name": "rueckblick-extension-chrome",
  "version": "0.3.1",
  "description": "Rueckblick MV3 browser extension: a thin sensor/actuator that samples the focused tab and hard-blocks exhausted URLs via the desktop-app bridge.",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "vite build && vite build --config vite.content.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "pnpm build && playwright test",
    "package": "pnpm build && node scripts/package.mjs",
    "lint:firefox": "web-ext lint --source-dir artifacts/firefox --self-hosted",
    "check-version": "node scripts/check-version.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "web-ext": "^10.6.0",
    "ws": "^8.21.3"
  }
}
