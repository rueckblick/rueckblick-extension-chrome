{
  "name": "rueckblick-extension-chrome",
  "version": "0.1.0",
  "description": "Rueckblick MV3 browser extension: a thin sensor/actuator that samples the focused tab and hard-blocks exhausted URLs via the desktop-app bridge.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "build": "vite build && vite build --config vite.content.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.2",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
